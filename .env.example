# CC-CIDICT annotator — copy to `.env` and adjust.
# Real environment variables always override values in this file.

PORT=3100

# SQLite dictionary file. Relative paths resolve from the project directory.
# Download: https://cdn.cidict.org/annotator/cc-cidict.db
CIDICT_DB=./data/cc-cidict.db

# Optional: JSON manifest berisi {"version": <int>, "databaseMd5": "<hex>", ...}
# Download: https://cdn.cidict.org/annotator/version.json
# Bila diset, backend mendeteksi update DB dari field `version`, me-reload
# kamus otomatis tanpa restart, dan memverifikasi integritas file via
# `databaseMd5`. Kosongkan untuk deteksi via mtime file DB.
CIDICT_DB_VERSION_FILE=./data/version.json

# Matikan verifikasi databaseMd5 (mis. bila suatu hari terasa berat).
CIDICT_DB_HASH_CHECK=true
CIDICT_MIN_FREQ=1000
CIDICT_HMM=false
CIDICT_CACHE_SIZE=1000

# Persistent disk cache (SQLite, survives restarts). Empty = disabled.
# Parent dir dibuat otomatis (satu level); untuk path lebih dalam buat manual.
CIDICT_CACHE_FILE=./data/annotate-cache.db
CIDICT_CACHE_DISK_SIZE=10000

# Rate limit POST /api/annotate: maks request per IP per 60 detik
# (0 = nonaktif). Lindungi dari client yang tidak bertanggung jawab.
CIDICT_RATE_LIMIT=120

# Token proteksi POST /api/seg-reload. Koneksi TCP langsung dari localhost
# bebas token; dari luar wajib token via header "Authorization: Bearer <token>"
# atau query "?token=<token>". Tanpa token ini, non-localhost = 403.
CIDICT_RELOAD_TOKEN=TULIS_TOKEN_UNIK_DAN_PANJANG_DISINI
