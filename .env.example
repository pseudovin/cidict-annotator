# CC-CIDICT annotator — copy to `.env` and adjust.
# Real environment variables always override values in this file.

PORT=3100
# SQLite dictionary file. Relative paths resolve from the project directory.
CIDICT_DB=./data/cc-cidict.db

# Optional: JSON manifest berisi {"version": <int>, "entryCount": <int>, ...}
# (mis. version.json updater APK). Bila diset, backend mendeteksi update DB
# dari field `version` dan me-reload kamus otomatis tanpa restart.
# Kosongkan untuk deteksi via mtime file DB.
CIDICT_DB_VERSION_FILE=./data/version.json

CIDICT_MIN_FREQ=1000
CIDICT_HMM=false
CIDICT_CACHE_SIZE=1000

# Persistent disk cache (SQLite, survives restarts). Empty = disabled.
# Parent dir dibuat otomatis (satu level); untuk path lebih dalam buat manual.
CIDICT_CACHE_FILE=./data/annotate-cache.db
CIDICT_CACHE_DISK_SIZE=10000
